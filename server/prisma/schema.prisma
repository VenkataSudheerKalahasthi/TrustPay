// ============================================================

enum OrgRoleType {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ApiKeyScope {
  READ_ONLY
  FULL_ACCESS
  WEBHOOKS_ONLY
}

enum WebhookStatus {
  ACTIVE
  PAUSED
  DISABLED
}

model Organization {
  id             String                   @id @default(cuid())
  name           String
  slug           String                   @unique
  logo           String?
  primaryColor   String?                  @default("#0ea5e9")
  companyAddress String?                  @db.Text
  isArchived     Boolean                  @default(false)
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  members               OrganizationMember[]
  invitations           OrganizationInvitation[]
  workspaces            Workspace[]
  roles                 OrganizationRole[]
  workSchedules         WorkSchedule[]
  timesheets            Timesheet[]
  capacityPlans         CapacityPlan[]
  productivityMetrics   ProductivityMetric[]
  productivitySnapshots ProductivitySnapshot[]
  leaveRequests         LeaveRequest[]
  leaveBalances         LeaveBalance[]
  teamAssignments       TeamAssignment[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRoleType  @default(MEMBER)
  lastActiveAt   DateTime     @default(now())
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  workspaceMemberships WorkspaceMember[]

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model OrganizationInvitation {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById    String
  invitedBy      User             @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  email          String
  role           OrgRoleType      @default(MEMBER)
  token          String           @unique
  status         InvitationStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime         @default(now())

  @@map("organization_invitations")
}

model OrganizationRole {
  id             String                 @id @default(cuid())
  organizationId String
  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isCustom       Boolean                @default(false)
  createdAt      DateTime               @default(now())

  permissions    OrganizationPermission[]

  @@map("organization_roles")
}

model OrganizationPermission {
  id     String           @id @default(cuid())
  roleId String
  role   OrganizationRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  action String

  @@map("organization_permissions")
}

model Workspace {
  id             String            @id @default(cuid())
  organizationId String
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  slug           String
  isFavorite     Boolean           @default(false)
  isArchived     Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  members        WorkspaceMember[]
  settings       WorkspaceSetting?

  @@unique([organizationId, slug])
  @@map("workspaces")
}

model WorkspaceMember {
  id                 String             @id @default(cuid())
  workspaceId        String
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  orgMemberId        String
  organizationMember OrganizationMember @relation(fields: [orgMemberId], references: [id], onDelete: Cascade)
  role               OrgRoleType        @default(MEMBER)
  createdAt          DateTime           @default(now())

  @@unique([workspaceId, orgMemberId])
  @@map("workspace_members")
}

model WorkspaceSetting {
  id          String    @id @default(cuid())
  workspaceId String    @unique
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  theme       String    @default("DARK")
  configJson  String?   @db.Text
  createdAt   DateTime  @default(now())

  @@map("workspace_settings")
}

model ApiKey {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  keyPrefix      String
  keyHash        String       @unique
  scopes         ApiKeyScope  @default(FULL_ACCESS)
  ipRestrictions String?
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([userId])
  @@map("api_keys")
}

model Webhook {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  url           String
  secret        String
  events        String
  status        WebhookStatus @default(ACTIVE)
  retryCount    Int           @default(0)
  lastSuccessAt DateTime?
  createdAt     DateTime      @default(now())

  deliveries    WebhookDelivery[]

  @@index([userId])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String   @id @default(cuid())
  webhookId    String
  webhook      Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String
  payloadJson  String   @db.Text
  responseCode Int?
  status       String   @default("SENT")
  deliveredAt  DateTime @default(now())

  @@index([webhookId])
  @@map("webhook_deliveries")
}

model Integration {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  category        String   @default("COLLABORATION")
  status          String   @default("ACTIVE")
  syncHistoryJson String?  @db.Text
  createdAt       DateTime @default(now())

  credentials     IntegrationCredential[]

  @@map("integrations")
}

model IntegrationCredential {
  id            String      @id @default(cuid())
  integrationId String
  integration   Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  userId        String
  accessToken   String      @db.Text
  refreshToken  String?     @db.Text
  expiresAt     DateTime?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([integrationId, userId])
  @@map("integration_credentials")
}

model FeatureFlag {
  id                String    @id @default(cuid())
  key               String    @unique
  name              String
  description       String?
  isEnabled         Boolean   @default(true)
  rolloutPercentage Int       @default(100)
  targetingJson     String?   @db.Text
  scheduledStart    DateTime?
  scheduledEnd      DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("feature_flags")
}

model PlatformSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  category  String   @default("SYSTEM")
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model AuditConfiguration {
  id            String   @id @default(cuid())
  moduleName    String   @unique
  isAuditOn     Boolean  @default(true)
  retentionDays Int      @default(90)

  @@map("audit_configurations")
}

model AdminAnnouncement {
  id          String    @id @default(cuid())
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  title       String
  message     String    @db.Text
  targetRole  String?   @default("ALL")
  scheduledAt DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  @@map("admin_announcements")
}

model SystemMaintenance {
  id             String    @id @default(cuid())
  title          String
  reason         String    @db.Text
  scheduledStart DateTime
  scheduledEnd   DateTime
  isActive       Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@map("system_maintenances")
}

// ============================================================
// PHASE 3 PART 4 – Security, File Management & Operations
// ============================================================

enum SecuritySeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum FileAccessType {
  READ
  DOWNLOAD
  UPDATE
  DELETE
  SHARE
}

enum VirusStatus {
  CLEAN
  SUSPICIOUS
  INFECTED
  QUARANTINED
  PENDING
}

enum BackupStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model SecurityEvent {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      String
  severity    SecuritySeverity @default(LOW)
  ipAddress   String?
  userAgent   String?
  detailsJson String?          @db.Text
  createdAt   DateTime         @default(now())

  @@index([userId])
  @@map("security_events")
}

model SecurityIncident {
  id          String           @id @default(cuid())
  userId      String?
  user        User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String
  description String           @db.Text
  severity    SecuritySeverity @default(HIGH)
  status      IncidentStatus   @default(OPEN)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("security_incidents")
}

model LoginHistory {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String?
  userAgent String?
  location  String?
  isSuccess Boolean  @default(true)
  loginAt   DateTime @default(now())

  @@index([userId])
  @@map("login_histories")
}

model TrustedDevice {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName  String
  deviceType  String   @default("DESKTOP")
  fingerprint String   @unique
  lastUsedAt  DateTime @default(now())
  isTrusted   Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("trusted_devices")
}

model UserSessionAudit {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String    @unique
  ipAddress String?
  isRevoked Boolean   @default(false)
  loginAt   DateTime  @default(now())
  revokedAt DateTime?

  @@index([userId])
  @@map("user_session_audits")
}

model FileAsset {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?
  workspaceId    String?
  name           String
  mimeType       String
  sizeBytes      Int
  checksum       String
  storagePath    String
  isFavorite     Boolean  @default(false)
  isArchived     Boolean  @default(false)
  tags           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  versions   FileVersion[]
  shares     FileShare[]
  accessLogs FileAccessLog[]
  virusScan  VirusScanResult?

  @@index([userId])
  @@map("file_assets")
}

model FileVersion {
  id            String    @id @default(cuid())
  fileAssetId   String
  fileAsset     FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  versionNumber Int
  sizeBytes     Int
  checksum      String
  storagePath   String
  comment       String?
  createdAt     DateTime  @default(now())

  @@map("file_versions")
}

model FileAccessLog {
  id          String         @id @default(cuid())
  fileAssetId String
  fileAsset   FileAsset      @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  accessType  FileAccessType @default(READ)
  accessedBy  String?
  ipAddress   String?
  accessedAt  DateTime       @default(now())

  @@index([fileAssetId])
  @@map("file_access_logs")
}

model FileShare {
  id            String    @id @default(cuid())
  fileAssetId   String
  fileAsset     FileAsset @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  shareToken    String    @unique
  passwordHash  String?
  downloadLimit Int?
  downloadCount Int       @default(0)
  expiresAt     DateTime?
  isRevoked     Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@map("file_shares")
}

model VirusScanResult {
  id          String      @id @default(cuid())
  fileAssetId String      @unique
  fileAsset   FileAsset   @relation(fields: [fileAssetId], references: [id], onDelete: Cascade)
  status      VirusStatus @default(CLEAN)
  engineName  String      @default("TRUSTPAY_DEFENDER")
  scanDetails String?
  scannedAt   DateTime    @default(now())

  @@map("virus_scan_results")
}

model BackupJob {
  id            String       @id @default(cuid())
  name          String
  type          String       @default("DATABASE")
  status        BackupStatus @default(COMPLETED)
  sizeBytes     BigInt       @default(0)
  checksum      String?
  retentionDays Int          @default(30)
  createdAt     DateTime     @default(now())

  histories BackupHistory[]

  @@map("backup_jobs")
}

model BackupHistory {
  id          String    @id @default(cuid())
  backupJobId String
  backupJob   BackupJob @relation(fields: [backupJobId], references: [id], onDelete: Cascade)
  restoredBy  String?
  restoredAt  DateTime  @default(now())

  @@map("backup_histories")
}

model Secret {
  id             String    @id @default(cuid())
  name           String    @unique
  encryptedValue String    @db.Text
  maskPrefix     String    @default("tp_sec_")
  version        Int       @default(1)
  expiresAt      DateTime?
  lastRotatedAt  DateTime  @default(now())

  @@map("secrets")
}

model SystemOperation {
  id         String   @id @default(cuid())
  name       String
  category   String   @default("BACKGROUND_JOB")
  status     String   @default("SUCCESS")
  executedAt DateTime @default(now())

  logs OperationLog[]

  @@map("system_operations")
}

model OperationLog {
  id          String          @id @default(cuid())
  operationId String
  operation   SystemOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  logLevel    String          @default("INFO")
  message     String          @db.Text
  createdAt   DateTime        @default(now())

  @@map("operation_logs")
}

model ComplianceReport {
  id          String   @id @default(cuid())
  reportType  String   @default("GDPR_AUDIT")
  status      String   @default("COMPLETED")
  fileUrl     String?
  generatedAt DateTime @default(now())

  @@map("compliance_reports")
}

model RetentionPolicy {
  id            String   @id @default(cuid())
  moduleName    String   @unique
  retentionDays Int      @default(365)

  @@map("retention_policies")
}

model DataExportRequest {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      ExportStatus @default(PENDING)
  downloadUrl String?
  requestedAt DateTime     @default(now())

  @@map("data_export_requests")
}

// ============================================================
// PHASE 4 PART 1 – Talent Marketplace Foundation
// ============================================================

enum JobStatus {
  DRAFT
  OPEN
  PAUSED
  FILLED
  EXPIRED
  CANCELLED
  ARCHIVED
}

enum JobWorkType {
  HOURLY
  FIXED
  MILESTONE
}

enum JobVisibility {
  PUBLIC
  PRIVATE
  ORGANIZATION
  INVITATION_ONLY
}

enum ExperienceLevel {
  ENTRY
  INTERMEDIATE
  EXPERT
}

enum ProposalStatus {
  SUBMITTED
  SHORTLISTED
  INTERVIEW
  OFFERED
  ACCEPTED
  REJECTED
  WITHDRAWN
  EXPIRED
  ARCHIVED
}

enum InterviewStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum QuestionType {
  SHORT_TEXT
  PARAGRAPH
  MULTIPLE_CHOICE
  BOOLEAN
  NUMERIC
}

model Job {
  id              String          @id @default(cuid())
  clientUserId    String
  clientUser      User            @relation("ClientJobs", fields: [clientUserId], references: [id], onDelete: Cascade)
  organizationId  String?
  workspaceId     String?
  title           String
  slug            String          @unique
  description     String          @db.Text
  categoryId      String?
  workType        JobWorkType     @default(FIXED)
  budget          Float?
  hourlyMin       Float?
  hourlyMax       Float?
  experienceLevel ExperienceLevel @default(INTERMEDIATE)
  visibility      JobVisibility  @default(PUBLIC)
  status          JobStatus       @default(OPEN)
  proposalCount   Int             @default(0)
  deadlineAt      DateTime?
  version         Int             @default(1)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  skills      JobSkillRequirement[]
  questions   ScreeningQuestion[]
  attachments JobAttachment[]
  proposals   Proposal[]
  interviews  Interview[]
  offers      Offer[]
  activities  HiringActivity[]
  bookmarks   JobBookmark[]

  @@index([clientUserId])
  @@index([status])
  @@index([categoryId])
  @@map("jobs")
}

model JobSkillRequirement {
  id          String  @id @default(cuid())
  jobId       String
  job         Job     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skillId     String
  isMandatory Boolean @default(true)

  @@index([jobId])
  @@map("job_skill_requirements")
}

model ScreeningQuestion {
  id          String       @id @default(cuid())
  jobId       String
  job         Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  question    String
  type        QuestionType @default(SHORT_TEXT)
  optionsJson String?      @db.Text
  isRequired  Boolean      @default(true)

  answers ProposalAnswer[]

  @@index([jobId])
  @@map("screening_questions")
}

model JobAttachment {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  name        String
  storagePath String
  sizeBytes   Int
  createdAt   DateTime @default(now())

  @@index([jobId])
  @@map("job_attachments")
}

model Proposal {
  id           String         @id @default(cuid())
  jobId        String
  job          Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  workerUserId String
  workerUser   User           @relation("WorkerProposals", fields: [workerUserId], references: [id], onDelete: Cascade)
  coverLetter  String         @db.Text
  bidAmount    Float
  estimatedDays Int
  status       ProposalStatus @default(SUBMITTED)
  isFrozen     Boolean        @default(false)
  version      Int            @default(1)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  milestones ProposalMilestone[]
  answers    ProposalAnswer[]
  interviews Interview[]
  offers     Offer[]
  activities HiringActivity[]

  @@unique([jobId, workerUserId])
  @@index([workerUserId])
  @@index([status])
  @@map("proposals")
}

model ProposalMilestone {
  id           String   @id @default(cuid())
  proposalId   String
  proposal     Proposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  title        String
  amount       Float
  durationDays Int
  orderIndex   Int      @default(0)

  @@index([proposalId])
  @@map("proposal_milestones")
}

model ProposalAnswer {
  id                  String            @id @default(cuid())
  proposalId          String
  proposal            Proposal          @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  screeningQuestionId String
  screeningQuestion   ScreeningQuestion @relation(fields: [screeningQuestionId], references: [id], onDelete: Cascade)
  answerText          String            @db.Text

  @@index([proposalId])
  @@map("proposal_answers")
}

model Interview {
  id           String          @id @default(cuid())
  jobId        String
  job          Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposalId   String
  proposal     Proposal        @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  clientUserId String
  clientUser   User            @relation("ClientInterviews", fields: [clientUserId], references: [id], onDelete: Cascade)
  workerUserId String
  workerUser   User            @relation("WorkerInterviews", fields: [workerUserId], references: [id], onDelete: Cascade)
  scheduledAt  DateTime
  meetingUrl   String?
  status       InterviewStatus @default(SCHEDULED)
  version      Int             @default(1)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([jobId])
  @@index([proposalId])
  @@map("interviews")
}

model Offer {
  id           String      @id @default(cuid())
  jobId        String
  job          Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposalId   String
  proposal     Proposal    @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  clientUserId String
  clientUser   User        @relation("ClientOffers", fields: [clientUserId], references: [id], onDelete: Cascade)
  workerUserId String
  workerUser   User        @relation("WorkerOffers", fields: [workerUserId], references: [id], onDelete: Cascade)
  totalAmount  Float
  terms        String      @db.Text
  status       OfferStatus @default(SENT)
  version      Int         @default(1)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([jobId])
  @@index([proposalId])
  @@map("offers")
}

model HiringActivity {
  id         String    @id @default(cuid())
  jobId      String
  job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  proposalId String?
  proposal   Proposal? @relation(fields: [proposalId], references: [id], onDelete: SetNull)
  actorId    String
  action     String
  durationMs Int?
  notes      String?   @db.Text
  createdAt  DateTime  @default(now())

  @@index([jobId])
  @@map("hiring_activities")
}

model JobBookmark {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@map("job_bookmarks")
}

model JobSavedSearch {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  queryJson String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("job_saved_searches")
}

// ============================================================
// PHASE 4 PART 2 – Talent Discovery, Matching & Recommendation Engine
// ============================================================

enum TalentPoolVisibility {
  PRIVATE
  ORGANIZATION
  PUBLIC
}

enum CandidateLifecycleStatus {
  DISCOVERED
  SAVED
  SHORTLISTED
  INVITED
  INTERVIEWING
  HIRED
  REJECTED
}

enum RecommendationType {
  WORKER_MATCH
  JOB_MATCH
  SIMILAR_WORKER
  SIMILAR_JOB
}

enum MatchingStrategy {
  SKILL_BASED
  WEIGHTED
  AI_ASSISTED
  CUSTOM
}

model TalentPool {
  id             String               @id @default(cuid())
  clientUserId   String
  clientUser     User                 @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  organizationId String?
  name           String
  description    String?              @db.Text
  visibility     TalentPoolVisibility @default(PRIVATE)
  version        Int                  @default(1)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  candidates SavedCandidate[]

  @@index([clientUserId])
  @@map("talent_pools")
}

model SavedCandidate {
  id           String                   @id @default(cuid())
  talentPoolId String
  talentPool   TalentPool               @relation(fields: [talentPoolId], references: [id], onDelete: Cascade)
  workerUserId String
  status       CandidateLifecycleStatus @default(SAVED)
  notes        String?                  @db.Text
  createdAt    DateTime                 @default(now())

  @@index([talentPoolId])
  @@map("saved_candidates")
}

model CandidateRecommendation {
  id                 String             @id @default(cuid())
  jobId              String
  workerUserId       String
  score              Float
  skillMatchPct      Float
  experienceMatchPct Float
  reasonsJson        String?            @db.Text
  type               RecommendationType @default(WORKER_MATCH)
  createdAt          DateTime           @default(now())

  @@index([jobId])
  @@index([workerUserId])
  @@map("candidate_recommendations")
}

model MatchingConfiguration {
  id                 String           @id @default(cuid())
  clientUserId       String
  clientUser         User             @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  strategy           MatchingStrategy @default(WEIGHTED)
  skillWeight        Float            @default(40.0)
  experienceWeight   Float            @default(20.0)
  ratingWeight       Float            @default(20.0)
  availabilityWeight Float            @default(20.0)
  version            Int              @default(1)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@unique([clientUserId])
  @@map("matching_configurations")
}

model CandidateComparison {
  id            String   @id @default(cuid())
  clientUserId  String
  workerUserIds String   @db.Text
  createdAt     DateTime @default(now())

  @@index([clientUserId])
  @@map("candidate_comparisons")
}

model RecruitmentActivity {
  id        String   @id @default(cuid())
  actorId   String
  targetId  String?
  action    String
  notes     String?  @db.Text
  createdAt DateTime @default(now())

  @@map("recruitment_activities")
}

model WorkerAvailability {
  id           String             @id @default(cuid())
  userId       String             @unique
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       AvailabilityStatus @default(AVAILABLE)
  hoursPerWeek Int                @default(40)
  version      Int                @default(1)
  updatedAt    DateTime           @updatedAt

  @@map("worker_availabilities")
}

model RecommendationFeedback {
  id               String   @id @default(cuid())
  recommendationId String
  userId           String
  isHelpful        Boolean  @default(true)
  comment          String?  @db.Text
  version          Int      @default(1)
  createdAt        DateTime @default(now())

  @@map("recommendation_feedbacks")
}

model TalentSearchHistory {
  id          String   @id @default(cuid())
  userId      String
  query       String
  filtersJson String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("talent_search_histories")
}

model TalentSavedFilter {
  id          String   @id @default(cuid())
  userId      String
  name        String
  filtersJson String   @db.Text
  createdAt   DateTime @default(now())

  @@index([userId])
  @@map("talent_saved_filters")
}

model CandidateInvitation {
  id           String                   @id @default(cuid())
  jobId        String
  clientUserId String
  clientUser   User                     @relation("SentInvitations", fields: [clientUserId], references: [id], onDelete: Cascade)
  workerUserId String
  workerUser   User                     @relation("ReceivedInvitations", fields: [workerUserId], references: [id], onDelete: Cascade)
  message      String?                  @db.Text
  status       CandidateLifecycleStatus @default(INVITED)
  version      Int                      @default(1)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  @@index([jobId])
  @@index([workerUserId])
  @@map("candidate_invitations")
}

model MatchingProfile {
  id           String   @id @default(cuid())
  workerUserId String   @unique
  vectorScore  Float    @default(0.95)
  updatedAt    DateTime @updatedAt

  @@map("matching_profiles")
}

model RecommendationCache {
  id          String   @id @default(cuid())
  cacheKey    String   @unique
  payloadJson String   @db.Text
  expiresAt   DateTime

  @@map("recommendation_caches")
}

// ============================================================
// PHASE 4 PART 3 – Enterprise Workforce Operations & Productivity Suite
// ============================================================

enum ShiftStatus {
  SCHEDULED
  ACTIVE
  COMPLETED
  MISSED
  CANCELLED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  REMOTE
  HALF_DAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum TimesheetStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum AllocationStatus {
  PLANNED
  ALLOCATED
  IN_PROGRESS
  COMPLETED
}

enum CapacityStatus {
  AVAILABLE
  FULL
  OVERLOADED
  UNAVAILABLE
}

model WorkSchedule {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?       @db.Text
  timezone       String        @default("UTC")
  isDefault      Boolean       @default(false)
  isActive       Boolean       @default(true)
  version        Int           @default(1)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  shifts WorkShift[]

  @@index([organizationId])
  @@map("work_schedules")
}

model WorkShift {
  id                String       @id @default(cuid())
  scheduleId        String
  schedule          WorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  name              String
  startTime         String
  endTime           String
  daysOfWeek        String       @default("[1,2,3,4,5]")
  breakDurationMins Int          @default(60)
  status            ShiftStatus  @default(SCHEDULED)
  assignedUserId    String?
  assignedUser      User?        @relation("AssignedShiftUser", fields: [assignedUserId], references: [id], onDelete: SetNull)
  version           Int          @default(1)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  timeEntries       TimeEntry[]
  attendanceRecords AttendanceRecord[]

  @@index([scheduleId])
  @@index([assignedUserId])
  @@map("work_shifts")
}

model TimeEntry {
  id           String           @id @default(cuid())
  workerUserId String
  workerUser   User             @relation(fields: [workerUserId], references: [id], onDelete: Cascade)
  projectId    String?
  contractId   String?
  workShiftId  String?
  workShift    WorkShift?       @relation(fields: [workShiftId], references: [id], onDelete: SetNull)
  clockIn      DateTime         @default(now())
  clockOut     DateTime?
  status       AttendanceStatus @default(PRESENT)
  isBillable   Boolean          @default(true)
  breakMinutes Int              @default(0)
  notes        String?          @db.Text
  hourlyRate   Float?
  version      Int              @default(1)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  approvals TimeEntryApproval[]

  @@index([workerUserId])
  @@index([projectId])
  @@index([workShiftId])
  @@map("time_entries")
}

model TimeEntryApproval {
  id           String          @id @default(cuid())
  timeEntryId  String
  timeEntry    TimeEntry       @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)
  approvedById String
  approvedBy   User            @relation(fields: [approvedById], references: [id], onDelete: Cascade)
  status       TimesheetStatus @default(APPROVED)
  notes        String?         @db.Text
  createdAt    DateTime        @default(now())

  @@index([timeEntryId])
  @@index([approvedById])
  @@map("time_entry_approvals")
}

model Timesheet {
  id             String          @id @default(cuid())
  workerUserId   String
  workerUser     User            @relation(fields: [workerUserId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  status         TimesheetStatus @default(DRAFT)
  totalHours     Float           @default(0.0)
  billableHours  Float           @default(0.0)
  overtimeHours  Float           @default(0.0)
  approvedById   String?
  notes          String?         @db.Text
  version        Int             @default(1)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([workerUserId])
  @@index([organizationId])
  @@map("timesheets")
}

model CapacityPlan {
  id                  String         @id @default(cuid())
  organizationId      String
  organization        Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name                String
  startDate           DateTime
  endDate             DateTime
  targetCapacityHours Float
  totalAllocatedHours Float          @default(0.0)
  status              CapacityStatus @default(AVAILABLE)
  notes               String?        @db.Text
  version             Int            @default(1)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  allocations WorkAllocation[]

  @@index([organizationId])
  @@map("capacity_plans")
}

model WorkAllocation {
  id             String           @id @default(cuid())
  capacityPlanId String
  capacityPlan   CapacityPlan     @relation(fields: [capacityPlanId], references: [id], onDelete: Cascade)
  workerUserId   String
  workerUser     User             @relation(fields: [workerUserId], references: [id], onDelete: Cascade)
  projectId      String?
  role           String?
  allocatedHours Float
  startDate      DateTime
  endDate        DateTime
  status         AllocationStatus @default(PLANNED)
  utilizationPct Float            @default(0.0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([capacityPlanId])
  @@index([workerUserId])
  @@map("work_allocations")
}

model ProductivityMetric {
  id                String        @id @default(cuid())
  workerUserId      String
  workerUser        User          @relation(fields: [workerUserId], references: [id], onDelete: Cascade)
  organizationId    String?
  organization      Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  period            String
  billableHours     Float         @default(0.0)
  idleHours         Float         @default(0.0)
  overtimeHours     Float         @default(0.0)
  attendancePct     Float         @default(100.0)
  utilizationPct    Float         @default(100.0)
  efficiencyScore   Float         @default(100.0)
  productivityScore Float         @default(100.0)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([workerUserId])
  @@index([organizationId])
  @@map("productivity_metrics")
}

model ProductivitySnapshot {
  id                   String       @id @default(cuid())
  organizationId       String
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshotDate         DateTime     @default(now())
  avgProductivityScore Float
  avgUtilizationPct    Float
  totalBillableHours   Float
  totalIdleHours       Float
  activeWorkersCount   Int
  createdAt            DateTime     @default(now())

  @@index([organizationId])
  @@map("productivity_snapshots")
}

model AttendanceRecord {
  id           String           @id @default(cuid())
  workerUserId String
  workerUser   User             @relation(fields: [workerUserId], references: [id], onDelete: Cascade)
  workShiftId  String?
  workShift    WorkShift?       @relation(fields: [workShiftId], references: [id], onDelete: SetNull)
  date         DateTime
  status       AttendanceStatus @default(PRESENT)
  checkIn      DateTime?
  checkOut     DateTime?
  remarks      String?          @db.Text
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([workerUserId])
  @@index([workShiftId])
  @@map("attendance_records")
}

model LeaveRequest {
  id             String        @id @default(cuid())
  workerUserId   String
  workerUser     User          @relation(fields: [workerUserId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leaveType      String        @default("VACATION")
  startDate      DateTime
  endDate        DateTime
  totalDays      Float
  reason         String?       @db.Text
  status         LeaveStatus   @default(PENDING)
  approvedById   String?
  rejectedReason String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([workerUserId])
  @@index([organizationId])
  @@map("leave_requests")
}

model LeaveBalance {
  id             String        @id @default(cuid())
  workerUserId   String
  workerUser     User          @relation(fields: [workerUserId], references: [id], onDelete: Cascade)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year           Int
  totalAllowance Float         @default(20.0)
  usedDays       Float         @default(0.0)
  pendingDays    Float         @default(0.0)
  remainingDays  Float         @default(20.0)
  updatedAt      DateTime      @updatedAt

  @@unique([workerUserId, year])
  @@index([organizationId])
  @@map("leave_balances")
}

model TeamAssignment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workerUserId   String
  workerUser     User         @relation(fields: [workerUserId], references: [id], onDelete: Cascade)
  teamName       String
  role           String?
  assignedAt     DateTime     @default(now())
  isLead         Boolean      @default(false)

  @@index([organizationId])
  @@index([workerUserId])
  @@map("team_assignments")
}

model WorkforcePreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferredShiftStart  String?
  maxHoursPerWeek      Int      @default(40)
  autoClockOut         Boolean  @default(false)
  timezone             String   @default("UTC")
  notificationsEnabled Boolean  @default(true)
  updatedAt            DateTime @updatedAt

  @@map("workforce_preferences")
}

// ============================================================
// PHASE 4 PART 4 – Customer Success, Support & Service Operations
// ============================================================

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  ESCALATED
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum TicketSource {
  WEB
  EMAIL
  CHAT
  SYSTEM
  API
}

enum SLAStatus {
  ON_TRACK
  AT_RISK
  BREACHED
}

enum KnowledgeStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  GENERAL
  SATISFACTION
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  NEGOTIATION
  RESOLVED
  CLOSED
}

model TicketCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tickets SupportTicket[]

  @@map("ticket_categories")
}

model TicketPriorityRule {
  id             String         @id @default(cuid())
  name           String
  priority       TicketPriority @default(MEDIUM)
  maxResponseHrs Int            @default(24)
  maxResolveHrs  Int            @default(72)
  createdAt      DateTime       @default(now())

  @@map("ticket_priority_rules")
}

model SupportTicket {
  id              String         @id @default(cuid())
  ticketNumber    String         @unique
  requesterUserId String
  requesterUser   User           @relation("TicketRequester", fields: [requesterUserId], references: [id], onDelete: Cascade)
  assigneeUserId  String?
  assigneeUser    User?          @relation("TicketAssignee", fields: [assigneeUserId], references: [id], onDelete: SetNull)
  categoryId      String?
  category        TicketCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subject         String
  description     String         @db.Text
  status          TicketStatus   @default(OPEN)
  priority        TicketPriority @default(MEDIUM)
  source          TicketSource   @default(WEB)
  organizationId  String?
  contractId      String?
  projectId       String?
  slaStatus       SLAStatus      @default(ON_TRACK)
  responseDueAt   DateTime?
  resolutionDueAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  version         Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  messages    TicketMessage[]
  attachments TicketAttachment[]
  assignments TicketAssignment[]
  watchers    TicketWatcher[]
  slaMetrics  SLAMetric[]
  disputes    DisputeCase[]

  @@index([requesterUserId])
  @@index([assigneeUserId])
  @@index([status])
  @@index([priority])
  @@map("support_tickets")
}

model TicketMessage {
  id         String        @id @default(cuid())
  ticketId   String
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId   String
  sender     User          @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body       String        @db.Text
  isInternal Boolean       @default(false)
  createdAt  DateTime      @default(now())

  attachments TicketAttachment[]

  @@index([ticketId])
  @@index([senderId])
  @@map("ticket_messages")
}

model TicketAttachment {
  id         String         @id @default(cuid())
  ticketId   String
  ticket     SupportTicket  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  messageId  String?
  message    TicketMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  fileName   String
  fileUrl    String
  fileSize   Int
  mimeType   String
  createdAt  DateTime       @default(now())

  @@index([ticketId])
  @@map("ticket_attachments")
}

model TicketAssignment {
  id           String        @id @default(cuid())
  ticketId     String
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  assignedById String
  assignedToId String
  assignedTo   User          @relation("AssignedAgent", fields: [assignedToId], references: [id], onDelete: Cascade)
  assignedAt   DateTime      @default(now())

  @@index([ticketId])
  @@map("ticket_assignments")
}

model TicketWatcher {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId   String
  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedAt  DateTime      @default(now())

  @@unique([ticketId, userId])
  @@map("ticket_watchers")
}

model SLAPolicy {
  id                    String   @id @default(cuid())
  name                  String
  description           String?  @db.Text
  firstResponseTimeMins Int      @default(120)
  resolutionTimeMins    Int      @default(1440)
  isDefault             Boolean  @default(false)
  createdAt             DateTime @default(now())

  metrics SLAMetric[]

  @@map("sla_policies")
}

model SLAMetric {
  id                    String        @id @default(cuid())
  ticketId              String
  ticket                SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  slaPolicyId           String?
  slaPolicy             SLAPolicy?    @relation(fields: [slaPolicyId], references: [id], onDelete: SetNull)
