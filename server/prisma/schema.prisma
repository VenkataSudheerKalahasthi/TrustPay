// ============================================================
// TrustPay – Prisma Schema
// ============================================================
// Database:  Supabase PostgreSQL
// ORM:       Prisma ORM
// Phase:     1 (Foundation) & 2 (Part 1, Part 2, Part 3 Escrow Wallet)
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// SYSTEM MODELS
// ============================================================

model SystemMigration {
  id          String   @id @default(cuid())
  version     String   @unique
  description String
  appliedAt   DateTime @default(now())

  @@map("system_migrations")
}

// ============================================================
// PHASE 1 PART 2 – Authentication
// ============================================================

enum Role {
  CLIENT
  WORKER
  ADMIN
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

model User {
  id                       String   @id @default(cuid())
  firstName                String
  lastName                 String
  email                    String   @unique
  phone                    String?
  passwordHash             String
  role                     Role     @default(CLIENT)
  avatar                   String?
  isEmailVerified          Boolean  @default(false)
  emailVerificationToken   String?
  emailVerificationExpires DateTime?
  passwordResetToken       String?
  passwordResetExpires     DateTime?
  isActive                 Boolean  @default(true)
  lastLogin                DateTime?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  refreshTokens RefreshToken[]
  sessions      Session[]
  workerProfile WorkerProfile?
  clientProfile ClientProfile?
  
  contractVersions             ContractVersion[]
  contractSignatures           ContractSignature[]
  contractActivities           ContractActivity[]
  walletTransactions           WalletTransaction[]
  paymentEvents                PaymentEvent[]
  createdProjects              Project[]                @relation("ProjectCreator")
  projectMemberships           ProjectMember[]
  submittedDeliverableVersions DeliverableVersion[]     @relation("DeliverableSubmitter")
  uploadedProjectEvidence      ProjectEvidence[]
  projectTimelines             ProjectTimeline[]
  projectComments              ProjectComment[]
  projectActivities            ProjectActivity[]
  projectStatusChanges         ProjectStatusHistory[]
  projectAttachments           ProjectAttachment[]
  createdConversations         Conversation[]           @relation("CreatedConversations")
  conversationMemberships      ConversationParticipant[]
  sentMessages                 Message[]                @relation("SentMessages")
  deletedMessages              Message[]                @relation("DeletedMessages")
  editedMessageVersions        MessageVersion[]
  uploadedChatAttachments      MessageAttachment[]
  messageReactions             MessageReaction[]
  messageReads                 MessageRead[]
  mentions                     Mention[]
  typingSessions               TypingSession[]
  presence                     OnlinePresence?
  notificationPreference       NotificationPreference?
  dashboardPreference          DashboardPreference?
  savedReports                 SavedReport[]
  reportExports                ReportExport[]
  notifications                Notification[]
  actorActivities              Activity[]               @relation("ActorActivities")
  targetActivities             Activity[]               @relation("TargetActivities")
  userPreference               UserPreference?
  notificationDeliveries       NotificationDelivery[]
  aiConversations              AiConversation[]
  aiUsages                     AiUsage[]
  savedSearches                SavedSearch[]
  recentSearches               RecentSearch[]
  searchAnalytics              SearchAnalytics[]
  searchPreference             SearchPreference?
  bookmarks                    Bookmark[]
  pinnedItems                  PinnedItem[]
  recentlyViewed               RecentlyViewed[]
  organizationMemberships      OrganizationMember[]
  organizationInvitationsSent  OrganizationInvitation[] @relation("SentInvitations")
  apiKeys                      ApiKey[]
  webhooks                     Webhook[]
  adminAnnouncements           AdminAnnouncement[]
  securityEvents               SecurityEvent[]
  securityIncidents            SecurityIncident[]
  loginHistories               LoginHistory[]
  trustedDevices               TrustedDevice[]
  userSessionAudits            UserSessionAudit[]
  fileAssets                   FileAsset[]
  dataExportRequests           DataExportRequest[]
  jobs                         Job[]                    @relation("ClientJobs")
  proposals                    Proposal[]               @relation("WorkerProposals")
  interviewsAsClient           Interview[]              @relation("ClientInterviews")
  interviewsAsWorker           Interview[]              @relation("WorkerInterviews")
  offersAsClient               Offer[]                  @relation("ClientOffers")
  offersAsWorker               Offer[]                  @relation("WorkerOffers")
  jobBookmarks                 JobBookmark[]
  jobSavedSearches             JobSavedSearch[]
  talentPools                  TalentPool[]
  candidateInvitationsSent     CandidateInvitation[]    @relation("SentInvitations")
  candidateInvitationsReceived CandidateInvitation[]    @relation("ReceivedInvitations")
  matchingConfigurations       MatchingConfiguration[]
  workerAvailability           WorkerAvailability?
  assignedShifts               WorkShift[]              @relation("AssignedShiftUser")
  timeEntries                  TimeEntry[]
  timeEntryApprovals           TimeEntryApproval[]
  timesheets                   Timesheet[]
  workAllocations              WorkAllocation[]
  productivityMetrics          ProductivityMetric[]
  attendanceRecords            AttendanceRecord[]
  leaveRequests                LeaveRequest[]
  leaveBalances                LeaveBalance[]
  teamAssignments              TeamAssignment[]
  workforcePreference          WorkforcePreference?
  createdSupportTickets        SupportTicket[]          @relation("TicketRequester")
  assignedSupportTickets       SupportTicket[]          @relation("TicketAssignee")
  ticketMessages               TicketMessage[]
  ticketAssignments            TicketAssignment[]       @relation("AssignedAgent")
  ticketWatchers               TicketWatcher[]
  authoredKnowledgeArticles    KnowledgeBaseArticle[]
  submittedCustomerFeedbacks   CustomerFeedback[]
  customerSatisfactions        CustomerSatisfaction[]
  raisedDisputes               DisputeCase[]            @relation("DisputeRaiser")
  targetDisputes               DisputeCase[]            @relation("DisputeTarget")
  orgSubscriptions             OrganizationSubscription[]
  billingProfiles              BillingProfile[]
  paymentMethods               PaymentMethod[]
  budgets                      Budget[]
  revenueLedgerEntries         RevenueLedger[]
  expenseLedgerEntries         ExpenseLedger[]
  executiveDashboards          ExecutiveDashboard[]
  executiveReports             ExecutiveReport[]
  businessGoals                BusinessGoal[]
  platformAudits               PlatformAudit[]
  deploymentRecords            DeploymentRecord[]
  adminWorkspaces              AdminWorkspace[]
  adminActionHistories         AdminActionHistory[]
  userAdministrativeNotes      UserAdministrativeNote[] @relation("AdminNotesTarget")
  createdAdminNotes            UserAdministrativeNote[] @relation("AdminNotesAuthor")
  userRestrictions             UserRestriction[]        @relation("UserRestrictionsTarget")
  imposedRestrictions          UserRestriction[]        @relation("UserRestrictionsAuthor")
  verificationReviews          UserVerificationReview[] @relation("VerificationReviewsTarget")
  reviewedVerifications        UserVerificationReview[] @relation("VerificationReviewsReviewer")
  analyticsDashboards          ExecutiveAnalyticsDashboard[]
  analyticsReports             ExecutiveAnalyticsReport[]

  @@map("users")
}

model RefreshToken {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash       String   @unique
  expiresAt       DateTime
  isRevoked       Boolean  @default(false)
  replacedByToken String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  session Session?

  @@index([userId])
  @@map("refresh_tokens")
}

model Session {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenId  String?       @unique
  refreshToken    RefreshToken? @relation(fields: [refreshTokenId], references: [id], onDelete: SetNull)
  deviceName      String?
  browser         String?
  operatingSystem String?
  ipAddress       String?
  loginTime       DateTime      @default(now())
  lastActiveTime  DateTime      @default(now())
  logoutTime      DateTime?
  expiresAt       DateTime
  status          SessionStatus @default(ACTIVE)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([userId])
  @@index([refreshTokenId])
  @@index([status])
  @@map("sessions")
}

// ============================================================
// PHASE 2 PART 1 – Client & Worker Profiles
// ============================================================

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum AvailabilityStatus {
  AVAILABLE
  BUSY
  ON_VACATION
  OFFLINE
}

enum DocumentType {
  GOVERNMENT_ID
  PASSPORT
  DRIVING_LICENSE
  NATIONAL_ID
  PAN_CARD
  AADHAAR_CARD
  OTHER
}

enum LanguageProficiency {
  BASIC
  CONVERSATIONAL
  FLUENT
  NATIVE
}

model WorkerProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug               String             @unique
  title              String?
  bio                String?            @db.Text
  hourlyRate         Float?
  preferFixedPrice   Boolean            @default(false)
  availabilityStatus AvailabilityStatus @default(AVAILABLE)
  workingDays        String[]           @default(["MON", "TUE", "WED", "THU", "FRI"])
  workingHours       String?
  timeZone           String?            @default("Asia/Kolkata")
  preferredSchedule  String?
  yearsExperience    Int                @default(0)
  address            String?
  city               String?
  state              String?
  country            String?            @default("India")
  postalCode         String?
  latitude           Float?
  longitude          Float?
  formattedAddress   String?
  resumeUrl          String?
  coverImageUrl      String?
  profileCompletion  Int                @default(0)
  verificationStatus VerificationStatus @default(PENDING)
  verificationNote   String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  categories            WorkerCategory[]
  skills                WorkerSkill[]
  portfolioProjects     PortfolioProject[]
  educations            Education[]
  certifications        Certification[]
  languages             WorkerLanguage[]
  verificationDocuments WorkerVerificationDocument[]
  socialLinks           SocialLink[]
  favoritedBy           FavoriteWorker[]
  contracts             Contract[]                 @relation("WorkerContracts")
  escrowReleases        EscrowRelease[]
  invoices              Invoice[]
  projects              Project[]

  @@index([userId])
  @@index([slug])
  @@map("worker_profiles")
}

model ClientProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName         String?
  companyType         String?
  companyWebsite      String?
  companyLogo         String?
  businessDescription String?  @db.Text
  industry            String?
  address             String?
  city                String?
  state               String?
  country             String?  @default("India")
  postalCode          String?
  latitude            Float?
  longitude           Float?
  formattedAddress    String?
  profileCompletion   Int      @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  favoriteWorkers FavoriteWorker[]
  contracts       Contract[]       @relation("ClientContracts")
  escrowWallet    EscrowWallet?
  escrowRefunds   EscrowRefund[]
  invoices        Invoice[]
  projects        Project[]

  @@index([userId])
  @@map("client_profiles")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  icon        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workers WorkerCategory[]

  @@map("categories")
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workers WorkerSkill[]

  @@map("skills")
}

model WorkerCategory {
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  assignedAt      DateTime      @default(now())

  @@id([workerProfileId, categoryId])
  @@map("worker_categories")
}

model WorkerSkill {
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  skillId         String
  skill           Skill         @relation(fields: [skillId], references: [id], onDelete: Cascade)
  assignedAt      DateTime      @default(now())

  @@id([workerProfileId, skillId])
  @@map("worker_skills")
}

model PortfolioProject {
  id              String   @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  title           String
  description     String?  @db.Text
  projectUrl      String?
  githubUrl       String?
  completionDate  DateTime?
  images          String[] @default([])
  documents       String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  technologies PortfolioTechnology[]

  @@index([workerProfileId])
  @@map("portfolio_projects")
}

model Technology {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects PortfolioTechnology[]

  @@map("technologies")
}

model PortfolioTechnology {
  portfolioProjectId String
  portfolioProject   PortfolioProject @relation(fields: [portfolioProjectId], references: [id], onDelete: Cascade)
  technologyId       String
  technology         Technology       @relation(fields: [technologyId], references: [id], onDelete: Cascade)

  @@id([portfolioProjectId, technologyId])
  @@map("portfolio_technologies")
}

model Education {
  id              String    @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  institution     String
  degree          String
  fieldOfStudy    String?
  startDate       DateTime
  endDate         DateTime?
  isCurrent       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workerProfileId])
  @@map("educations")
}

model Certification {
  id                  String    @id @default(cuid())
  workerProfileId     String
  workerProfile       WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  title               String
  issuingOrganization String
  issueDate           DateTime
  expirationDate      DateTime?
  credentialId        String?
  credentialUrl       String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([workerProfileId])
  @@map("certifications")
}

model Language {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workers WorkerLanguage[]

  @@map("languages")
}

model WorkerLanguage {
  workerProfileId String
  workerProfile   WorkerProfile       @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  languageId      String
  language        Language            @relation(fields: [languageId], references: [id], onDelete: Cascade)
  proficiency     LanguageProficiency @default(CONVERSATIONAL)

  @@id([workerProfileId, languageId])
  @@map("worker_languages")
}

model WorkerVerificationDocument {
  id                 String             @id @default(cuid())
  workerProfileId    String
  workerProfile      WorkerProfile      @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  documentType       DocumentType
  documentUrl        String
  documentNumber     String?
  verificationStatus VerificationStatus @default(PENDING)
  verificationNote   String?
  uploadedAt         DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([workerProfileId])
  @@map("worker_verification_documents")
}

model SocialLink {
  id              String   @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  platform        String
  url             String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([workerProfileId])
  @@map("social_links")
}

model FavoriteWorker {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())

  @@unique([clientProfileId, workerProfileId])
  @@map("favorite_workers")
}

// ============================================================
// PHASE 2 PART 2 – Digital Contract System
// ============================================================

enum ContractStatus {
  DRAFT
  PENDING_REVIEW
  PENDING_ACCEPTANCE
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED
  ARCHIVED
}

enum SignatureStatus {
  PENDING
  SIGNED
}

model Contract {
  id                   String         @id @default(cuid())
  contractNumber       String         @unique // e.g. "TP-2026-000001"
  clientProfileId      String
  clientProfile        ClientProfile  @relation("ClientContracts", fields: [clientProfileId], references: [id], onDelete: Cascade)
  workerProfileId      String
  workerProfile        WorkerProfile  @relation("WorkerContracts", fields: [workerProfileId], references: [id], onDelete: Cascade)
  escrowWalletId       String?
  escrowWallet         EscrowWallet?  @relation(fields: [escrowWalletId], references: [id], onDelete: SetNull)
  escrowState          EscrowState    @default(PENDING)
  title                String
  description          String?        @db.Text
  scopeOfWork          String         @db.Text
  deliverables         String         @db.Text
  termsAndConditions   String         @db.Text
  paymentTermsText     String?        @db.Text
  status               ContractStatus @default(DRAFT)
  currentVersionNumber Int            @default(1)
  contentHash          String?
  pdfHash              String?
  signatureHash        String?
  startDate            DateTime?
  endDate              DateTime?
  expirationDate       DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  cancelledAt          DateTime?
  expiredAt            DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  versions           ContractVersion[]
  attachments        ContractAttachment[]
  signatures         ContractSignature[]
  activities         ContractActivity[]
  walletTransactions WalletTransaction[]
  escrowDeposits     EscrowDeposit[]
  escrowReleases     EscrowRelease[]
  escrowRefunds      EscrowRefund[]
  invoices           Invoice[]
  projects           Project[]
  conversations      Conversation[]
  notifications      Notification[]
  systemActivities   Activity[]

  @@index([clientProfileId])
  @@index([workerProfileId])
  @@index([contractNumber])
  @@index([status])
  @@map("contracts")
}

model ContractTemplate {
  id                 String   @id @default(cuid())
  title              String
  category           String
  description        String?  @db.Text
  scopeOfWork        String   @db.Text
  deliverables       String   @db.Text
  termsAndConditions String   @db.Text
  isSystemTemplate   Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("contract_templates")
}

model ContractVersion {
  id                 String   @id @default(cuid())
  contractId         String
  contract           Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  versionNumber      Int
  title              String
  scopeOfWork        String   @db.Text
  deliverables       String   @db.Text
  termsAndConditions String   @db.Text
  paymentTermsText   String?  @db.Text
  createdByUserId    String
  createdByUser      User     @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  changeSummary      String?
  createdAt          DateTime @default(now())

  attachments ContractAttachment[]

  @@unique([contractId, versionNumber])
  @@index([contractId])
  @@map("contract_versions")
}

model ContractAttachment {
  id                String           @id @default(cuid())
  contractId        String
  contract          Contract         @relation(fields: [contractId], references: [id], onDelete: Cascade)
  contractVersionId String?
  contractVersion   ContractVersion? @relation(fields: [contractVersionId], references: [id], onDelete: SetNull)
  fileName          String
  fileUrl           String
  fileType          String
  fileSize          Int
  uploadedByUserId  String
  createdAt         DateTime         @default(now())

  @@index([contractId])
  @@map("contract_attachments")
}

model ContractSignature {
  id                 String          @id @default(cuid())
  contractId         String
  contract           Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  signerUserId       String
  signerUser         User            @relation(fields: [signerUserId], references: [id], onDelete: Cascade)
  signerRole         Role
  signatureStatus    SignatureStatus @default(PENDING)
  signatureTimestamp DateTime?
  ipAddress          String?
  userAgent          String?
  signatureHash      String?

  @@unique([contractId, signerUserId])
  @@index([contractId])
  @@map("contract_signatures")
}

model ContractActivity {
  id             String          @id @default(cuid())
  contractId     String
  contract       Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  action         String
  previousStatus ContractStatus?
  newStatus      ContractStatus?
  details        String?         @db.Text
  reason         String?         @db.Text
  createdAt      DateTime        @default(now())

  @@index([contractId])
  @@map("contract_activities")
}

// ============================================================
// PHASE 2 PART 3 – Escrow Wallet & Payment Management
// ============================================================

enum EscrowWalletStatus {
  ACTIVE
  FROZEN
  SUSPENDED
  CLOSED
}

enum EscrowState {
  PENDING
  FUNDED
  HELD
  RELEASED
  REFUNDED
  CANCELLED
}

enum TransactionType {
  DEPOSIT
  HOLD
  RELEASE
  REFUND
  CANCEL
  REVERSAL
}

enum DepositStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum ReleaseType {
  FULL
  PARTIAL
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model EscrowWallet {
  id               String             @id @default(cuid())
  clientProfileId  String             @unique
  clientProfile    ClientProfile      @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  status           EscrowWalletStatus @default(ACTIVE)
  currency         String             @default("INR") // ISO-4217
  minorUnits       Int                @default(100)   // Paise for INR
  exchangeRate     Float?             @default(1.0)
  totalBalance     Float              @default(0.0)
  availableBalance Float              @default(0.0)
  heldBalance      Float              @default(0.0)
  releasedBalance  Float              @default(0.0)
  refundedBalance  Float              @default(0.0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  contracts    Contract[]
  transactions WalletTransaction[]
  deposits     EscrowDeposit[]
  releases     EscrowRelease[]
  refunds      EscrowRefund[]
  invoices     Invoice[]
  projects     Project[]

  @@index([clientProfileId])
  @@map("escrow_wallets")
}

model WalletTransaction {
  id              String          @id @default(cuid())
  escrowWalletId  String
  escrowWallet    EscrowWallet    @relation(fields: [escrowWalletId], references: [id], onDelete: Cascade)
  contractId      String?
  contract        Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  idempotencyKey  String?         @unique
  type            TransactionType
  amount          Float
  currency        String          @default("INR")
  balanceBefore   Float
  balanceAfter    Float
  referenceNumber String          @unique
  description     String?         @db.Text
  actorUserId     String?
  actorUser       User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime        @default(now())

  @@index([escrowWalletId])
  @@index([contractId])
  @@index([referenceNumber])
  @@map("wallet_transactions")
}

model EscrowDeposit {
  id               String        @id @default(cuid())
  escrowWalletId   String
  escrowWallet     EscrowWallet  @relation(fields: [escrowWalletId], references: [id], onDelete: Cascade)
  contractId       String?
  contract         Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  idempotencyKey   String?       @unique
  razorpayOrderId  String        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount           Float
  currency         String        @default("INR")
  status           DepositStatus @default(PENDING)
  receiptNumber    String        @unique
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([escrowWalletId])
  @@index([razorpayOrderId])
  @@map("escrow_deposits")
}

model EscrowRelease {
  id              String        @id @default(cuid())
  escrowWalletId  String
  escrowWallet    EscrowWallet  @relation(fields: [escrowWalletId], references: [id], onDelete: Cascade)
  contractId      String
  contract        Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  idempotencyKey  String?       @unique
  amount          Float
  currency        String        @default("INR")
  releaseType     ReleaseType   @default(FULL)
  notes           String?       @db.Text
  releasedByUserId String
  createdAt       DateTime      @default(now())

  @@index([escrowWalletId])
  @@index([contractId])
  @@map("escrow_releases")
}

model EscrowRefund {
  id               String        @id @default(cuid())
  escrowWalletId   String
  escrowWallet     EscrowWallet  @relation(fields: [escrowWalletId], references: [id], onDelete: Cascade)
  contractId       String
  contract         Contract      @relation(fields: [contractId], references: [id], onDelete: Cascade)
  clientProfileId  String
  clientProfile    ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  idempotencyKey   String?       @unique
  amount           Float
  currency         String        @default("INR")
  reason           String?       @db.Text
  status           RefundStatus  @default(COMPLETED)
  refundedByUserId String
  createdAt        DateTime      @default(now())

  @@index([escrowWalletId])
  @@index([contractId])
  @@map("escrow_refunds")
}

model Invoice {
  id                String        @id @default(cuid())
  invoiceNumber     String        @unique // e.g. "INV-2026-000001"
  contractId        String?
  contract          Contract?     @relation(fields: [contractId], references: [id], onDelete: SetNull)
  escrowWalletId    String
  escrowWallet      EscrowWallet  @relation(fields: [escrowWalletId], references: [id], onDelete: Cascade)
  clientProfileId   String
  clientProfile     ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  workerProfileId   String?
  workerProfile     WorkerProfile? @relation(fields: [workerProfileId], references: [id], onDelete: SetNull)
  versionNumber     Int           @default(1)
  isLatest          Boolean       @default(true)
  amount            Float
  taxAmount         Float         @default(0.0)
  totalAmount       Float
  currency          String        @default("INR")
  paymentDetailsText String?      @db.Text
  pdfUrl            String?
  pdfHash           String?
  createdAt         DateTime      @default(now())

  @@index([invoiceNumber])
  @@index([escrowWalletId])
  @@index([clientProfileId])
  @@map("invoices")
}

model PaymentEvent {
  id             String    @id @default(cuid())
  idempotencyKey String?   @unique
  eventType      String    // e.g. "ORDER_CREATED", "PAYMENT_SUCCESS", "PAYMENT_FAILURE", "WEBHOOK_RECEIVED"
  gateway        String    @default("RAZORPAY")
  gatewayOrderId String?
  gatewayPaymentId String?
  userId         String?
  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  payload        String?   @db.Text
  status         String    @default("SUCCESS")
  errorMessage   String?   @db.Text
  ipAddress      String?
  createdAt      DateTime  @default(now())

  @@index([gatewayOrderId])
  @@index([eventType])
  @@map("payment_events")
}

// ============================================================
// PHASE 2 PART 4 – Project Management & Project Execution System
// ============================================================

enum ProjectStatus {
  DRAFT
  ACTIVE
  ON_HOLD
  IN_REVIEW
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MilestoneStatus {
  PENDING
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum DeliverableStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REVISION_REQUESTED
  REJECTED
}

enum EvidenceType {
  IMAGE
  VIDEO
  PDF
  ZIP
  DOCUMENT
  LINK
  OTHER
}

enum AttachmentCategory {
  REQUIREMENT
  DESIGN
  REFERENCE
  DELIVERABLE
  OTHER
}

enum ProjectMemberRole {
  OWNER
  WORKER
  COLLABORATOR
  VIEWER
}

model Project {
  id                String          @id @default(cuid())
  projectNumber     String          @unique // e.g. "PRJ-2026-000001"
  title             String
  description       String?         @db.Text
  category          String?
  clientProfileId   String
  clientProfile     ClientProfile   @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)
  workerProfileId   String?
  workerProfile     WorkerProfile?  @relation(fields: [workerProfileId], references: [id], onDelete: SetNull)
  contractId        String?
  contract          Contract?       @relation(fields: [contractId], references: [id], onDelete: SetNull)
  escrowWalletId    String?
  escrowWallet      EscrowWallet?   @relation(fields: [escrowWalletId], references: [id], onDelete: SetNull)
  priority          ProjectPriority @default(MEDIUM)
  status            ProjectStatus   @default(DRAFT)
  estimatedBudget   Float?
  estimatedDuration String?
  startDate         DateTime?
  targetEndDate     DateTime?
  actualEndDate     DateTime?
  notes             String?         @db.Text
  createdById       String
  createdBy         User            @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  
  startedAt         DateTime?
  onHoldAt          DateTime?
  inReviewAt        DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  archivedAt        DateTime?

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  members           ProjectMember[]
  milestones        ProjectMilestone[]
  deliverables      ProjectDeliverable[]
  evidenceList      ProjectEvidence[]
  timelines         ProjectTimeline[]
  comments          ProjectComment[]
  activities        ProjectActivity[]
  statusHistory     ProjectStatusHistory[]
  attachments       ProjectAttachment[]
  conversations     Conversation[]
  notifications     Notification[]
  systemActivities  Activity[]

  @@index([clientProfileId])
  @@index([workerProfileId])
  @@index([contractId])
  @@index([projectNumber])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id        String            @id @default(cuid())
  projectId String
  project   Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ProjectMemberRole @default(WORKER)
  joinedAt  DateTime          @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@map("project_members")
}

model ProjectMilestone {
  id                      String            @id @default(cuid())
  projectId               String
  project                 Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  prerequisiteMilestoneId String?
  prerequisiteMilestone   ProjectMilestone? @relation("MilestoneDependencies", fields: [prerequisiteMilestoneId], references: [id], onDelete: SetNull)
  dependentMilestones     ProjectMilestone[] @relation("MilestoneDependencies")
  title                   String
  description             String?           @db.Text
  dueDate                 DateTime?
  status                  MilestoneStatus   @default(PENDING)
  estimatedAmount         Float?
  completionPercentage    Int               @default(0)
  order                   Int               @default(1)
  completedAt             DateTime?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt

  deliverables            ProjectDeliverable[]
  evidenceList            ProjectEvidence[]
  comments                ProjectComment[]

  @@index([projectId])
  @@map("project_milestones")
}

model ProjectDeliverable {
  id                 String             @id @default(cuid())
  projectId          String
  project            Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId        String?
  milestone          ProjectMilestone?  @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  title              String
  description        String?            @db.Text
  status             DeliverableStatus  @default(DRAFT)
  currentVersion     Int                @default(1)
  revisionCount      Int                @default(0)
  clientFeedback     String?            @db.Text
  submittedAt        DateTime?
  approvedAt         DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  versions           DeliverableVersion[]
  evidenceList       ProjectEvidence[]
  attachments        ProjectAttachment[]
  comments           ProjectComment[]

  @@index([projectId])
  @@index([milestoneId])
  @@map("project_deliverables")
}

model DeliverableVersion {
  id                  String             @id @default(cuid())
  deliverableId       String
  deliverable         ProjectDeliverable @relation(fields: [deliverableId], references: [id], onDelete: Cascade)
  versionNumber       Int
  description         String?            @db.Text
  fileUrls            String[]           @default([])
  submittedByUserId   String
  submittedByUser     User               @relation("DeliverableSubmitter", fields: [submittedByUserId], references: [id], onDelete: Cascade)
  clientFeedback      String?            @db.Text
  status              DeliverableStatus  @default(SUBMITTED)
  submittedAt         DateTime           @default(now())

  @@unique([deliverableId, versionNumber])
  @@index([deliverableId])
  @@map("deliverable_versions")
}

model ProjectEvidence {
  id               String            @id @default(cuid())
  projectId        String
  project          Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId      String?
  milestone        ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  deliverableId    String?
  deliverable      ProjectDeliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  title            String
  description      String?           @db.Text
  evidenceType     EvidenceType      @default(DOCUMENT)
  fileUrl          String
  fileName         String
  fileSize         Int?
  mimeType         String?
  sha256Hash       String?           // Cryptographic hash for file integrity
  externalUrl      String?
  uploadedByUserId String
  uploadedByUser   User              @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  uploadedAt       DateTime          @default(now())

  @@index([projectId])
  @@index([milestoneId])
  @@index([deliverableId])
  @@map("project_evidence")
}

model ProjectTimeline {
  id                String    @id @default(cuid())
  projectId         String
  project           Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  eventType         String    // e.g., "CREATED", "STARTED", "MILESTONE_CREATED", "DELIVERABLE_SUBMITTED", "EVIDENCE_UPLOADED", "REVIEW_REQUESTED", "APPROVED", "REJECTED", "COMPLETED", "CANCELLED"
  title             String
  description       String?   @db.Text
  performedByUserId String?
  performedByUser   User?     @relation(fields: [performedByUserId], references: [id], onDelete: SetNull)
  metadata          String?   @db.Text
  createdAt         DateTime  @default(now())

  @@index([projectId])
  @@index([eventType])
  @@map("project_timelines")
}

model ProjectComment {
  id            String            @id @default(cuid())
  projectId     String
  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  milestoneId   String?
  milestone     ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  deliverableId String?
  deliverable   ProjectDeliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  authorUserId  String
  authorUser    User              @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  content       String            @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([projectId])
  @@map("project_comments")
}

model ProjectActivity {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorUser   User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  requestId   String?
  ipAddress   String?
  userAgent   String?
  action      String
  details     String?  @db.Text
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@map("project_activities")
}

model ProjectStatusHistory {
  id              String         @id @default(cuid())
  projectId       String
  project         Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  previousStatus  ProjectStatus?
  newStatus       ProjectStatus
  changedByUserId String
  changedByUser   User           @relation(fields: [changedByUserId], references: [id], onDelete: Cascade)
  reason          String?        @db.Text
  createdAt       DateTime       @default(now())

  @@index([projectId])
  @@map("project_status_history")
}

model ProjectAttachment {
  id               String             @id @default(cuid())
  projectId        String
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  deliverableId    String?
  deliverable      ProjectDeliverable? @relation(fields: [deliverableId], references: [id], onDelete: SetNull)
  category         AttachmentCategory @default(OTHER)
  fileName         String
  fileUrl          String
  fileType         String?
  fileSize         Int?
  uploadedByUserId String
  uploadedByUser   User               @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  createdAt        DateTime           @default(now())

  @@index([projectId])
  @@map("project_attachments")
}

// ============================================================
// PHASE 2 PART 5 – Communication & Collaboration System
// ============================================================

enum ConversationType {
  DIRECT
  PROJECT
  GROUP
}

enum MessageType {
  TEXT
  IMAGE
  FILE
  AUDIO
  VIDEO
  SYSTEM
}

enum DeliveryStatus {
  SENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum ParticipantRole {
  OWNER
  ADMIN
  MEMBER
}

enum PresenceStatus {
  ONLINE
  AWAY
  BUSY
  OFFLINE
  INVISIBLE
}

model Conversation {
  id                 String                    @id @default(cuid())
  conversationNumber String                    @unique // e.g. "CONV-2026-000001"
  type               ConversationType          @default(DIRECT)
  title              String?
  description        String?                   @db.Text
  projectId          String?
  project            Project?                  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contractId         String?
  contract           Contract?                 @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdById        String
  createdBy          User                      @relation("CreatedConversations", fields: [createdById], references: [id], onDelete: Cascade)
  isArchived         Boolean                   @default(false)
  lastMessageAt      DateTime?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt

  participants       ConversationParticipant[]
  messages           Message[]
  typingSessions     TypingSession[]

  @@index([projectId])
  @@index([contractId])
  @@index([conversationNumber])
  @@index([type])
  @@map("conversations")
}

model ConversationParticipant {
  id             String            @id @default(cuid())
  conversationId String
  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           ParticipantRole   @default(MEMBER)
  joinedAt       DateTime          @default(now())
  lastReadAt     DateTime?
  isMuted        Boolean           @default(false)

  @@unique([conversationId, userId])
  @@index([conversationId])
  @@index([userId])
  @@map("conversation_participants")
}

model Message {
  id                    String              @id @default(cuid())
  conversationId        String
  conversation          Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderUserId          String
  senderUser            User                @relation("SentMessages", fields: [senderUserId], references: [id], onDelete: Cascade)
  messageType           MessageType         @default(TEXT)
  content               String              @db.Text
  deliveryStatus        DeliveryStatus      @default(SENT)
  parentMessageId       String?
  parentMessage         Message?            @relation("MessageReplies", fields: [parentMessageId], references: [id], onDelete: SetNull)
  replies               Message[]           @relation("MessageReplies")
  forwardedFromMessageId String?
  currentVersion        Int                 @default(1)
  isEdited              Boolean             @default(false)
  editedAt              DateTime?
  isDeleted             Boolean             @default(false)
  deletedByUserId       String?
  deletedByUser         User?               @relation("DeletedMessages", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  deletedAt             DateTime?
  deleteReason          String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  versions              MessageVersion[]
  attachments           MessageAttachment[]
  reactions             MessageReaction[]
  reads                 MessageRead[]
  mentions              Mention[]

  @@index([conversationId])
  @@index([senderUserId])
  @@index([deliveryStatus])
  @@map("messages")
}

model MessageVersion {
  id              String   @id @default(cuid())
  messageId       String
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  versionNumber   Int
  previousContent String   @db.Text
  editedByUserId  String
  editedByUser    User     @relation(fields: [editedByUserId], references: [id], onDelete: Cascade)
  editReason      String?
  editedAt        DateTime @default(now())

  @@unique([messageId, versionNumber])
  @@index([messageId])
  @@map("message_versions")
}

model MessageAttachment {
  id               String   @id @default(cuid())
  messageId        String
  message          Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  fileName         String
  fileUrl          String
  fileType         String?
  fileSize         Int?
  mimeType         String?
  sha256Hash       String?  // Cryptographic hash for file integrity
  uploadedByUserId String
  uploadedByUser   User     @relation(fields: [uploadedByUserId], references: [id], onDelete: Cascade)
  uploadedAt       DateTime @default(now())

  @@index([messageId])
  @@map("message_attachments")
}

model MessageReaction {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime @default(now())

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
  @@map("message_reads")
}

model Mention {
  id              String   @id @default(cuid())
  messageId       String
  message         Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  mentionedUserId String
  mentionedUser   User     @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)
  mentionStatus   String   @default("UNSEEN") // UNSEEN, SEEN
  seenStatus      Boolean  @default(false)
  seenAt          DateTime?
  createdAt       DateTime @default(now())

  @@index([messageId])
  @@index([mentionedUserId])
  @@map("mentions")
}

model TypingSession {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt      DateTime     @default(now())
  expiresAt      DateTime

  @@index([conversationId])
  @@map("typing_sessions")
}

model OnlinePresence {
  id              String         @id @default(cuid())
  userId          String         @unique
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status          PresenceStatus @default(OFFLINE)
  socketId        String?
  lastHeartbeatAt DateTime       @default(now())
  lastSeenAt      DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([userId])
  @@map("online_presences")
}

model NotificationPreference {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailNotifications   Boolean  @default(true)
  soundEnabled         Boolean  @default(true)
  desktopNotifications Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("notification_preferences")
}

// ============================================================
// PHASE 2 PART 6 – Analytics & Business Dashboard System
// ============================================================

enum DateRangeType {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
  CUSTOM
}

enum ReportFormat {
  PDF
  CSV
  EXCEL
}

model DashboardPreference {
  id                String         @id @default(cuid())
  userId            String         @unique
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  defaultDateRange  DateRangeType  @default(MONTHLY)
  widgetsConfigJson String?        @db.Text
  themePreference   String         @default("DARK")
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@map("dashboard_preferences")
}

model SavedReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  reportType  String
  filtersJson String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@map("saved_reports")
}

model ReportExport {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportType  String
  format      ReportFormat @default(PDF)
  fileUrl     String?
  fileSize    Int?
  status      String       @default("COMPLETED") // PENDING, COMPLETED, FAILED
  generatedAt DateTime     @default(now())

  @@index([userId])
  @@map("report_exports")
}

model AnalyticsSnapshot {
  id           String        @id @default(cuid())
  snapshotDate DateTime
  periodType   DateRangeType @default(DAILY)
  metricsJson  String        @db.Text
  createdAt    DateTime      @default(now())

  @@index([snapshotDate])
  @@map("analytics_snapshots")
}

// ============================================================
// PHASE 3 PART 1 – Notification, Activity & Preferences System
// ============================================================

enum NotificationCategory {
  PROJECT
  CONTRACT
  ESCROW
  PAYMENT
  INVOICE
  MESSAGE
  PROFILE
  SYSTEM
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ActivityCategory {
  AUTH
  PROJECT
  CONTRACT
  ESCROW
  PAYMENT
  INVOICE
  MESSAGE
  PROFILE
  SYSTEM
}

enum ThemePreference {
  DARK
  LIGHT
  SYSTEM
}

model Notification {
  id           String               @id @default(cuid())
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  category     NotificationCategory @default(SYSTEM)
  priority     NotificationPriority @default(NORMAL)
  title        String
  message      String               @db.Text
  linkUrl      String?
  isRead       Boolean              @default(false)
  readAt       DateTime?
  isArchived   Boolean              @default(false)
  archivedAt   DateTime?
  isDeleted    Boolean              @default(false)
  deletedAt    DateTime?
  metadataJson String?              @db.Text
  projectId    String?
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contractId   String?
  contract     Contract?            @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdAt    DateTime             @default(now())

  deliveries   NotificationDelivery[]

  @@index([userId])
  @@index([category])
  @@index([isRead])
  @@map("notifications")
}

model NotificationTemplate {
  id              String               @id @default(cuid())
  templateCode    String               @unique
  category        NotificationCategory @default(SYSTEM)
  subjectTemplate String
  bodyTemplate    String               @db.Text
  isActive        Boolean              @default(true)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@map("notification_templates")
}

model Activity {
  id           String           @id @default(cuid())
  actorUserId  String?
  actorUser    User?            @relation("ActorActivities", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUserId String?
  targetUser   User?            @relation("TargetActivities", fields: [targetUserId], references: [id], onDelete: SetNull)
  category     ActivityCategory @default(SYSTEM)
  action       String
  title        String
  description  String?          @db.Text
  ipAddress    String?
  userAgent    String?
  metadataJson String?          @db.Text
  projectId    String?
  project      Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  contractId   String?
  contract     Contract?        @relation(fields: [contractId], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now())

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([category])
  @@map("activities")
}

model UserPreference {
  id                 String          @id @default(cuid())
  userId             String          @unique
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme              ThemePreference @default(DARK)
  language           String          @default("en")
  timezone           String          @default("UTC")
  currency           String          @default("INR")
  dateFormat         String          @default("DD/MM/YYYY")
  timeFormat         String          @default("12H")
  activityVisibility String          @default("PUBLIC")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@map("user_preferences")
}

model NotificationDelivery {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel        String       // IN_APP, EMAIL, SOCKET
